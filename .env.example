# Clé API Resend (https://resend.com/api-keys) — utilisée uniquement côté serveur.
RESEND_API_KEY=

# Adresse d'expédition. En dev, "onboarding@resend.dev" fonctionne sans domaine
# vérifié. En prod, utilisez une adresse sur un domaine vérifié dans Resend,
# ex. "RoboCare <contact@robocare.tn>".
CONTACT_EMAIL_FROM="RoboCare <onboarding@resend.dev>"

# Destinataire des messages du formulaire de contact.
CONTACT_EMAIL_TO=hanahmani3@gmail.com
