# Clé API Resend (https://resend.com/api-keys) — utilisée uniquement côté serveur.
RESEND_API_KEY=

# Adresse d'expédition. En dev, "onboarding@resend.dev" fonctionne sans domaine
# vérifié. En prod, utilisez une adresse sur un domaine vérifié dans Resend,
# ex. "RoboCare <contact@robocare.tn>".
CONTACT_EMAIL_FROM="RoboCare <onboarding@resend.dev>"

# Destinataire des messages du formulaire de contact.
CONTACT_EMAIL_TO=hanahmani3@gmail.com

# Active les en-têtes strictement liés à HTTPS (Strict-Transport-Security et
# la directive CSP "upgrade-insecure-requests"). Laisser à "true" (ou absent)
# en production normale sur un domaine avec certificat (ex. https://robocare.tn).
# Ne passer à "false" que sur un environnement temporaire servi en HTTP pur
# (ex. test par adresse IP sans certificat) : sinon le navigateur force tous
# les assets (CSS/JS/fonts/images) en HTTPS et échoue avec ERR_CONNECTION_REFUSED.
HTTPS_ENABLED=true
